#!/bin/bash
# Fake slb tool for testing
# Supports MODE environment variable: normal (default), timeout, error

MODE="${FAKE_TOOL_MODE:-normal}"

case "$MODE" in
    timeout)
        exec sleep 3600
        ;;
    error)
        echo "slb: simulated error" >&2
        exit 1
        ;;
esac

# Normal mode - check arguments
case "$1" in
    version|--version)
        echo "slb 0.1.0"
        echo "  commit:  abc123fake"
        echo "  built:   2025-01-01T00:00:00Z"
        echo "  go:      go1.24.0"
        exit 0
        ;;
    pending)
        if [[ "$*" == *"--json"* ]]; then
            echo '[]'
        else
            echo "No pending requests"
        fi
        exit 0
        ;;
    request)
        # Real slb files requests under an agent session (--session-id/-s).
        if [[ "$*" != *"--session-id"* && "$*" != *" -s "* ]]; then
            echo "Error: --session-id is required to create a request" >&2
            exit 1
        fi
        echo '{"request_id": "req-001", "command": "'"${@: -1}"'", "status": "pending", "tier": "dangerous", "min_approvals": 1}'
        exit 0
        ;;
    approve|reject)
        # Reviews need the reviewer session and its HMAC key.
        if [[ "$*" != *"--session-id"* || "$*" != *"--session-key"* ]]; then
            echo "Error: --session-id is required" >&2
            exit 1
        fi
        decision="approve"
        status="approved"
        if [[ "$1" == "reject" ]]; then
            decision="reject"
            status="rejected"
        fi
        echo '{"request_id": "'"${@: -1}"'", "decision": "'"$decision"'", "request_status_changed": true, "new_request_status": "'"$status"'"}'
        exit 0
        ;;
    daemon)
        echo "slb daemon running (fake)"
        exit 0
        ;;
    --help|-h)
        echo "slb - Simultaneous Launch Button (fake for testing)"
        echo "Usage: slb [command] [options]"
        echo "  --version          Show version"
        echo "  pending            List pending requests"
        echo "  request <cmd>      Create approval request"
        echo "  approve <id>       Approve a request"
        echo "  reject <id>        Reject a request"
        echo "  daemon             Start daemon"
        exit 0
        ;;
    *)
        echo "slb: unknown command: $1" >&2
        exit 1
        ;;
esac
