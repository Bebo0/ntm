#!/bin/bash
# Fake ms tool for testing
# Supports MODE environment variable: normal (default), timeout, error
# Mirrors the real CLI: global output flags precede the subcommand
# (ms -O json search -- QUERY) and JSON results come in status envelopes.

MODE="${FAKE_TOOL_MODE:-normal}"

case "$MODE" in
    timeout)
        exec sleep 3600
        ;;
    error)
        echo "ms: simulated error" >&2
        exit 1
        ;;
esac

JSON=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -O|--output-format)
            [[ "$2" == "json" ]] && JSON=1
            shift 2
            ;;
        -m|--machine)
            JSON=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

# Normal mode - check arguments
case "$1" in
    --version|-v|version)
        echo "ms 0.1.0"
        exit 0
        ;;
    search)
        if [[ "$JSON" == 1 ]]; then
            echo '{"status":"ok","query":"test","search_type":"hybrid","count":1,"results":[{"id":"test-skill","name":"Test Skill","description":"A test skill","layer":"project","score":0.95,"quality":0.5,"is_deprecated":false}]}'
        else
            echo "test-skill  Test Skill (0.95)"
        fi
        exit 0
        ;;
    show)
        if [[ "$JSON" == 1 ]]; then
            echo '{"status":"ok","skill":{"id":"test-skill","name":"Test Skill","description":"A test skill"}}'
        else
            echo "# Test Skill"
            echo "A test skill"
        fi
        exit 0
        ;;
    help|--help|-h|*)
        echo "ms - Meta Skill (fake for testing)"
        echo "Usage: ms [OPTIONS] <command>"
        echo "  search      Search for skills"
        echo "  show        Show skill details"
        exit 0
        ;;
esac
